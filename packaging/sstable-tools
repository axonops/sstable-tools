#!/bin/sh
set -eu

usage() {
  cat >&2 <<'EOF'
Usage: sstable-tools [--cassandra-lib-dir <path>] [tool options] <command>

Selects the matching SSTable Tools adapter from a Cassandra core JAR named
apache-cassandra-<version>.jar or cassandra-all-<version>.jar. The path may be
a tarball lib directory or a packaged Cassandra root such as
/usr/share/cassandra; both the root and its lib child are inventoried.

Selection inputs, in order:
  --cassandra-lib-dir <path>
  CASSANDRA_LIB_DIR
  --cassandra-home <path>
  CASSANDRA_HOME

All remaining options and commands are forwarded to the selected adapter.
EOF
  exit "${1:-64}"
}

cassandra_lib_dir=${CASSANDRA_LIB_DIR:-}
first_argument=${1:-}
if [ "$first_argument" = "--cassandra-lib-dir" ]; then
  if [ "$#" -lt 2 ] || [ -z "$2" ]; then
    usage
  fi
  cassandra_lib_dir=$2
  shift 2
elif [ "${first_argument#--cassandra-lib-dir=}" != "$first_argument" ]; then
  cassandra_lib_dir=${first_argument#--cassandra-lib-dir=}
  [ -n "$cassandra_lib_dir" ] || usage
  shift
fi

if [ "$#" -eq 0 ]; then
  usage
fi
if { [ "$1" = "--help" ] || [ "$1" = "-h" ]; } \
    && [ -z "$cassandra_lib_dir" ] \
    && [ -z "${CASSANDRA_HOME:-}" ]; then
  usage 0
fi

cassandra_home=
expect_home=false
for argument in "$@"; do
  if [ "$expect_home" = true ]; then
    cassandra_home=$argument
    expect_home=false
  elif [ "$argument" = "--cassandra-home" ]; then
    expect_home=true
  fi
done
[ "$expect_home" = false ] || usage

if [ -z "$cassandra_lib_dir" ] && [ -n "$cassandra_home" ]; then
  cassandra_lib_dir=$cassandra_home
fi
if [ -z "$cassandra_lib_dir" ] && [ -n "${CASSANDRA_HOME:-}" ]; then
  cassandra_home=$CASSANDRA_HOME
  cassandra_lib_dir=$cassandra_home
fi
if [ -z "$cassandra_lib_dir" ]; then
  printf 'error: set CASSANDRA_LIB_DIR or pass --cassandra-lib-dir <path>\n' >&2
  usage
fi
if [ ! -d "$cassandra_lib_dir" ]; then
  printf 'error: Cassandra runtime directory does not exist: %s\n' \
    "$cassandra_lib_dir" >&2
  exit 66
fi
cassandra_lib_dir=$(CDPATH='' cd -- "$cassandra_lib_dir" && pwd -P)

cassandra_version=
cassandra_core_jar=
cassandra_core_dir=
core_jar_count=0

is_cassandra_version() {
  detected_version=$1
  detected_major=${detected_version%%.*}
  [ "$detected_major" != "$detected_version" ] || return 1
  detected_remainder=${detected_version#*.}
  detected_minor=${detected_remainder%%.*}
  [ "$detected_minor" != "$detected_remainder" ] || return 1
  detected_patch_and_suffix=${detected_remainder#*.}
  detected_patch=${detected_patch_and_suffix%%[-.+~]*}

  case "$detected_major" in
    ''|*[!0-9]*) return 1 ;;
  esac
  case "$detected_minor" in
    ''|*[!0-9]*) return 1 ;;
  esac
  case "$detected_patch" in
    ''|*[!0-9]*) return 1 ;;
  esac

  detected_suffix=${detected_patch_and_suffix#"$detected_patch"}
  case "$detected_suffix" in
    '') ;;
    [-.+~]?*) ;;
    *) return 1 ;;
  esac
}

scan_cassandra_core_dir() {
  scan_dir=$1
  for candidate in \
    "$scan_dir"/apache-cassandra-*.jar \
    "$scan_dir"/cassandra-all-*.jar; do
    [ -f "$candidate" ] || continue
    filename=${candidate##*/}
    case "$filename" in
      apache-cassandra-*.jar)
        version=${filename#apache-cassandra-}
        ;;
      cassandra-all-*.jar)
        version=${filename#cassandra-all-}
        ;;
      *)
        continue
        ;;
    esac
    version=${version%.jar}
    is_cassandra_version "$version" || continue
    cassandra_version=$version
    cassandra_core_jar=$candidate
    cassandra_core_dir=$scan_dir
    core_jar_count=$((core_jar_count + 1))
  done
}

scan_cassandra_core_dir "$cassandra_lib_dir"
if [ -d "$cassandra_lib_dir/lib" ]; then
  scan_cassandra_core_dir "$cassandra_lib_dir/lib"
fi
if [ "${cassandra_lib_dir##*/}" = lib ]; then
  cassandra_parent_dir=$(dirname -- "$cassandra_lib_dir")
  scan_cassandra_core_dir "$cassandra_parent_dir"
fi

if [ "$core_jar_count" -eq 0 ]; then
  printf 'error: no apache-cassandra-<version>.jar or '\
'cassandra-all-<version>.jar found in the Cassandra runtime tree at %s\n' \
    "$cassandra_lib_dir" >&2
  exit 65
fi
if [ "$core_jar_count" -ne 1 ]; then
  printf 'error: multiple Cassandra core JARs found in the runtime tree at %s\n' \
    "$cassandra_lib_dir" >&2
  exit 65
fi

case "$cassandra_version" in
  3.11.*) release_line=3.11 ;;
  4.0.*) release_line=4.0 ;;
  4.1.*) release_line=4.1 ;;
  5.0.*) release_line=5.0 ;;
  *)
    printf 'error: unsupported Cassandra version %s from %s\n' \
      "$cassandra_version" "$cassandra_core_jar" >&2
    exit 65
    ;;
esac

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
if [ -n "${SSTABLE_TOOLS_JAR:-}" ]; then
  tool_jar=$SSTABLE_TOOLS_JAR
elif [ -n "${SSTABLE_TOOLS_HOME:-}" ]; then
  tool_jar=$SSTABLE_TOOLS_HOME/sstable-tools-cassandra-$release_line.jar
else
  tool_jar=
  jar_count=0
  for candidate in \
    "$script_dir"/sstable-tools-cassandra-"$release_line"-*.jar; do
    [ -f "$candidate" ] || continue
    tool_jar=$candidate
    jar_count=$((jar_count + 1))
  done
  if [ "$jar_count" -gt 1 ]; then
    printf 'error: multiple Cassandra %s adapter JARs found beside %s\n' \
      "$release_line" "$0" >&2
    exit 66
  fi
  if [ "$jar_count" -eq 0 ]; then
    installed_jar=/usr/share/sstable-tools/sstable-tools-cassandra-$release_line.jar
    if [ -r "$installed_jar" ]; then
      tool_jar=$installed_jar
    fi
  fi
fi

if [ -z "$tool_jar" ] || [ ! -r "$tool_jar" ]; then
  printf 'error: Cassandra %s adapter JAR is unavailable: %s\n' \
    "$release_line" "${tool_jar:-not found}" >&2
  exit 66
fi

if [ -n "${SSTABLE_TOOLS_JAVA:-}" ]; then
  java_command=$SSTABLE_TOOLS_JAVA
elif [ -n "${JAVA_HOME:-}" ]; then
  java_command=$JAVA_HOME/bin/java
else
  java_command=java
fi

if ! command -v "$java_command" >/dev/null 2>&1; then
  printf 'error: Java is unavailable: %s\n' "$java_command" >&2
  exit 69
fi

if [ -z "$cassandra_home" ]; then
  if [ "${cassandra_core_dir##*/}" = lib ]; then
    derived_home=$(dirname -- "$cassandra_core_dir")
  else
    derived_home=$cassandra_core_dir
  fi
  set -- --cassandra-home "$derived_home" "$@"
fi

java_options='-Djava.awt.headless=true -Dfile.encoding=UTF-8'
if [ -n "${SSTABLE_TOOLS_JAVA_OPTS:-}" ]; then
  java_options="$java_options $SSTABLE_TOOLS_JAVA_OPTS"
fi

# JVM options are intentionally whitespace-delimited; pathname expansion is
# disabled so values cannot unexpectedly expand files in the working directory.
set -f
# shellcheck disable=SC2086
exec "$java_command" $java_options -jar "$tool_jar" "$@"
