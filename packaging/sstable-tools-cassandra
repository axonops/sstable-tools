#!/bin/sh
set -eu

program=${0##*/}
case "$program" in
  sstable-tools-cassandra-3.11) release_line=3.11 ;;
  sstable-tools-cassandra-4.0) release_line=4.0 ;;
  sstable-tools-cassandra-4.1) release_line=4.1 ;;
  sstable-tools-cassandra-5.0) release_line=5.0 ;;
  *)
    printf 'error: unsupported SSTable Tools launcher name: %s\n' "$program" >&2
    exit 64
    ;;
esac

tool_home=${SSTABLE_TOOLS_HOME:-/usr/share/sstable-tools}
if [ -n "${SSTABLE_TOOLS_JAR:-}" ]; then
  tool_jar=$SSTABLE_TOOLS_JAR
elif [ -n "${SSTABLE_TOOLS_HOME:-}" ]; then
  tool_jar=$tool_home/sstable-tools-cassandra-$release_line.jar
elif [ -r "$tool_home/sstable-tools-cassandra-$release_line.jar" ]; then
  tool_jar=$tool_home/sstable-tools-cassandra-$release_line.jar
else
  script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
  tool_jar=
  jar_count=0
  for candidate in "$script_dir"/sstable-tools-cassandra-"$release_line"-*.jar; do
    [ -f "$candidate" ] || continue
    tool_jar=$candidate
    jar_count=$((jar_count + 1))
  done
  if [ "$jar_count" -ne 1 ]; then
    printf 'error: expected exactly one Cassandra %s adapter JAR beside %s\n' \
      "$release_line" "$0" >&2
    exit 66
  fi
fi

if [ ! -r "$tool_jar" ]; then
  printf 'error: SSTable Tools adapter is unreadable: %s\n' "$tool_jar" >&2
  exit 66
fi

if [ -n "${SSTABLE_TOOLS_JAVA:-}" ]; then
  java_command=$SSTABLE_TOOLS_JAVA
elif [ -n "${JAVA_HOME:-}" ]; then
  java_command=$JAVA_HOME/bin/java
else
  java_command=java
fi

if ! command -v "$java_command" >/dev/null 2>&1; then
  printf 'error: Java is unavailable: %s\n' "$java_command" >&2
  exit 69
fi

java_options='-Djava.awt.headless=true -Dfile.encoding=UTF-8'
if [ -n "${SSTABLE_TOOLS_JAVA_OPTS:-}" ]; then
  java_options="$java_options $SSTABLE_TOOLS_JAVA_OPTS"
fi

# JVM options are intentionally whitespace-delimited; pathname expansion is
# disabled so values cannot unexpectedly expand files in the working directory.
set -f
# shellcheck disable=SC2086
exec "$java_command" $java_options -jar "$tool_jar" "$@"
