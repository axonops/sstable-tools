#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
release_lines=("3.11" "4.0" "4.1" "5.0")
declare -A expected_class_versions=(
  ["3.11"]="52"
  ["4.0"]="52"
  ["4.1"]="55"
  ["5.0"]="61"
)
declare -A runtime_classes=(
  ["3.11"]="com.axonops.sstable.worker.cassandra311.Cassandra311Runtime"
  ["4.0"]="com.axonops.sstable.worker.cassandra40.Cassandra40Runtime"
  ["4.1"]="com.axonops.sstable.worker.cassandra41.Cassandra41Runtime"
  ["5.0"]="com.axonops.sstable.worker.cassandra50.Cassandra50Runtime"
)

smoke_root="$(mktemp -d)"
trap 'rm -rf "$smoke_root"' EXIT
smoke_source="$smoke_root/source"
mkdir -p "$smoke_source"
printf 'TOC.txt\nData.db\nStatistics.db\n' > "$smoke_source/mc-1-big-TOC.txt"
printf 'data\n' > "$smoke_source/mc-1-big-Data.db"
printf 'statistics\n' > "$smoke_source/mc-1-big-Statistics.db"

for release_line in "${release_lines[@]}"; do
  artifact_dir="$root_dir/workers/cassandra-$release_line/target"
  artifacts=("$artifact_dir"/sstable-tools-cassandra-"$release_line"-*.jar)

  if [[ ${#artifacts[@]} -ne 1 || ! -f "${artifacts[0]}" ]]; then
    printf 'Expected one Cassandra %s artifact under %s\n' \
      "$release_line" "$artifact_dir" >&2
    exit 1
  fi

  artifact="${artifacts[0]}"
  cassandra_entry=""
  unexpected_entry=""
  bootstrap_found=false
  worker_main_found=false
  relocated_gson_found=false

  while IFS= read -r entry; do
    case "$entry" in
      org/apache/cassandra/*)
        cassandra_entry="$entry"
        break
        ;;
      com/axonops/sstable/bootstrap/BootstrapMain.class)
        bootstrap_found=true
        ;;
      com/axonops/sstable/worker/api/WorkerMain.class)
        worker_main_found=true
        ;;
      com/axonops/sstable/internal/gson/Gson.class)
        relocated_gson_found=true
        ;;
      META-INF/*|com/|com/axonops/|com/axonops/sstable/|\
      com/axonops/sstable/bootstrap/*|com/axonops/sstable/workspace/*|\
      com/axonops/sstable/internal/|com/axonops/sstable/internal/gson/*|\
      com/axonops/sstable/worker/*|sstable-tools-adapter.properties)
        ;;
      *)
        unexpected_entry="$entry"
        break
        ;;
    esac
  done < <(jar tf "$artifact")

  if [[ -n "$cassandra_entry" ]]; then
    printf '%s contains forbidden Cassandra class %s\n' \
      "$artifact" "$cassandra_entry" >&2
    exit 1
  fi

  if [[ -n "$unexpected_entry" ]]; then
    printf '%s contains an unapproved packaged dependency/resource: %s\n' \
      "$artifact" "$unexpected_entry" >&2
    exit 1
  fi

  if [[ "$bootstrap_found" != true ]]; then
    printf '%s does not contain the shared bootstrap entry point\n' "$artifact" >&2
    exit 1
  fi

  if [[ "$worker_main_found" != true ]]; then
    printf '%s does not contain the worker child entry point\n' "$artifact" >&2
    exit 1
  fi

  if [[ "$relocated_gson_found" != true ]]; then
    printf '%s does not contain relocated Gson\n' "$artifact" >&2
    exit 1
  fi

  class_version="$(javap -classpath "$artifact" -verbose \
    "${runtime_classes[$release_line]}" | awk '/major version/ { print $3 }')"

  if [[ "$class_version" != "${expected_class_versions[$release_line]}" ]]; then
    printf '%s has class version %s; expected %s\n' \
      "$artifact" "$class_version" \
      "${expected_class_versions[$release_line]}" >&2
    exit 1
  fi

  help_output="$(java -jar "$artifact" --help)"
  version_output="$(java -jar "$artifact" --version)"

  if [[ "$help_output" != *"--cassandra-home"* ]]; then
    printf '%s cannot run bootstrap help without Cassandra\n' "$artifact" >&2
    exit 1
  fi

  if [[ "$help_output" != *"runtime preflight"* ]]; then
    printf '%s does not advertise runtime preflight\n' "$artifact" >&2
    exit 1
  fi

  if [[ "$version_output" != *"Cassandra $release_line adapter"* ]]; then
    printf '%s reports unexpected adapter metadata: %s\n' \
      "$artifact" "$version_output" >&2
    exit 1
  fi

  smoke_workspace="$smoke_root/workspace-$release_line"
  create_output="$(java -jar "$artifact" workspace create "$smoke_workspace" \
    --sstables "$smoke_source")"
  status_output="$(java -jar "$artifact" workspace status "$smoke_workspace")"

  if [[ "$create_output" != *"workspace.state=VALIDATED"* \
      || "$status_output" != *"source.integrity=verified"* ]]; then
    printf '%s cannot create and reopen a workspace from the packaged artifact\n' \
      "$artifact" >&2
    exit 1
  fi

  printf 'verified %s (%s bytes)\n' "$artifact" "$(stat -c %s "$artifact")"
done

bootstrap_artifacts=("$root_dir"/bootstrap/target/sstable-tools-bootstrap-*.jar)
if [[ ${#bootstrap_artifacts[@]} -ne 1 || ! -f "${bootstrap_artifacts[0]}" ]]; then
  printf 'Expected one bootstrap artifact under %s\n' \
    "$root_dir/bootstrap/target" >&2
  exit 1
fi

if rg -q 'com\.csforge\.sstable\.bootstrap\..*org\.apache\.cassandra' \
    < <(jdeps -verbose:class "${bootstrap_artifacts[0]}" 2>/dev/null); then
  printf '%s contains a bootstrap dependency on Cassandra classes\n' \
    "${bootstrap_artifacts[0]}" >&2
  exit 1
fi
