#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s [--output <directory>] [--version <version>] [--sign]\n' "$0" >&2
  exit 64
}

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output_dir="$root_dir/target/release"
version="$(sed -n 's/^[[:space:]]*<version>\([^<]*\)<\/version>[[:space:]]*$/\1/p' \
  "$root_dir/pom.xml" | head -n 1)"
if [[ "$version" == "\${revision}" ]]; then
  version="$(sed -n 's/^[[:space:]]*<revision>\([^<]*\)<\/revision>[[:space:]]*$/\1/p' \
    "$root_dir/pom.xml" | head -n 1)"
fi
sign=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output) output_dir=${2:-}; shift 2 ;;
    --version) version=${2:-}; shift 2 ;;
    --sign) sign=true; shift ;;
    *) usage ;;
  esac
done

[[ -n "$version" ]] || { printf 'Release version must not be empty\n' >&2; exit 1; }
[[ "$version" != *'/'* && "$version" != *$'\n'* ]] || {
  printf 'Release version contains an unsafe path character\n' >&2
  exit 1
}
command -v java >/dev/null 2>&1 || {
  printf 'java is required to verify release artifact versions\n' >&2
  exit 1
}

release_dir="$output_dir/sstable-tools-$version"
rm -rf "$release_dir"
mkdir -p "$release_dir"
cp "$root_dir/packaging/sstable-tools" "$release_dir/sstable-tools"
chmod 0755 "$release_dir/sstable-tools"

release_lines=(3.11 4.0 4.1 5.0)
for release_line in "${release_lines[@]}"; do
  artifact_dir="$root_dir/workers/cassandra-$release_line/target"
  artifact="$artifact_dir/sstable-tools-cassandra-$release_line-$version.jar"
  if [[ ! -f "$artifact" ]]; then
    printf 'Expected Cassandra %s thin JAR for version %s: %s\n' \
      "$release_line" "$version" "$artifact" >&2
    exit 1
  fi
  artifact_version="$(java -jar "$artifact" --version)"
  [[ "$artifact_version" == "sstable-tools $version "* ]] || {
    printf 'Cassandra %s artifact version does not match release %s: %s\n' \
      "$release_line" "$version" "$artifact_version" >&2
    exit 1
  }
  cp "$artifact" \
    "$release_dir/sstable-tools-cassandra-$release_line-$version.jar"
  cp "$root_dir/packaging/sstable-tools-cassandra" \
    "$release_dir/sstable-tools-cassandra-$release_line"
  chmod 0755 "$release_dir/sstable-tools-cassandra-$release_line"
done

revision="unknown"
if git -C "$root_dir" rev-parse --verify HEAD >/dev/null 2>&1; then
  revision="$(git -C "$root_dir" rev-parse HEAD)"
fi

cat >"$release_dir/compatibility-manifest.json" <<EOF
{
  "schemaVersion": 1,
  "toolVersion": "$version",
  "sourceRevision": "$revision",
  "adapters": [
    {"releaseLine": "3.11", "cassandra": "3.11.19", "java": "8", "artifact": "sstable-tools-cassandra-3.11-$version.jar"},
    {"releaseLine": "4.0", "cassandra": "4.0.17", "java": "8-11", "artifact": "sstable-tools-cassandra-4.0-$version.jar"},
    {"releaseLine": "4.1", "cassandra": "4.1.3", "java": "11", "artifact": "sstable-tools-cassandra-4.1-$version.jar"},
    {"releaseLine": "5.0", "cassandra": "5.0.4-5.0.8", "java": "17", "artifact": "sstable-tools-cassandra-5.0-$version.jar"}
  ]
}
EOF

cat >"$release_dir/sbom.spdx.json" <<EOF
{
  "spdxVersion": "SPDX-2.3",
  "dataLicense": "CC0-1.0",
  "SPDXID": "SPDXRef-DOCUMENT",
  "name": "sstable-tools-$version",
  "documentNamespace": "https://github.com/axonops/sstable-tools/releases/$version",
  "creationInfo": {"creators": ["Tool: scripts/package-release"]},
  "packages": [
    {"SPDXID": "SPDXRef-SSTableTools", "name": "sstable-tools", "versionInfo": "$version", "downloadLocation": "NOASSERTION", "licenseConcluded": "NOASSERTION", "licenseDeclared": "NOASSERTION", "filesAnalyzed": false, "externalRefs": [{"referenceCategory": "PACKAGE-MANAGER", "referenceType": "purl", "referenceLocator": "pkg:maven/com.axonops/sstable-tools@$version"}]},
    {"SPDXID": "SPDXRef-Gson", "name": "Gson", "versionInfo": "2.14.0", "downloadLocation": "https://github.com/google/gson", "licenseConcluded": "Apache-2.0", "licenseDeclared": "Apache-2.0", "filesAnalyzed": false, "externalRefs": [{"referenceCategory": "PACKAGE-MANAGER", "referenceType": "purl", "referenceLocator": "pkg:maven/com.google.code.gson/gson@2.14.0"}]}
  ],
  "relationships": [{"spdxElementId": "SPDXRef-SSTableTools", "relationshipType": "CONTAINS", "relatedSpdxElement": "SPDXRef-Gson"}]
}
EOF

cat >"$release_dir/THIRD-PARTY-NOTICES.txt" <<'EOF'
SSTable Tools packages Gson 2.14.0, relocated to
com.axonops.sstable.internal.gson. Gson is licensed under Apache License 2.0.

Cassandra classes and Cassandra runtime JARs are not included. The selected
installed Cassandra distribution supplies those dependencies at execution time.
EOF

(cd "$release_dir" && sha256sum -- sstable-tools sstable-tools-cassandra-* \
  compatibility-manifest.json sbom.spdx.json THIRD-PARTY-NOTICES.txt >SHA256SUMS)

if [[ "$sign" == true ]]; then
  command -v gpg >/dev/null || { printf 'gpg is required for --sign\n' >&2; exit 1; }
  gpg --armor --detach-sign --output "$release_dir/SHA256SUMS.asc" \
    "$release_dir/SHA256SUMS"
fi

printf 'release.directory=%s\n' "$release_dir"
printf 'release.version=%s\n' "$version"
printf 'release.sourceRevision=%s\n' "$revision"
