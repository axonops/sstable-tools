#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s --tool-jar <path> --cassandra-home <path> --java-home <path> --output-root <path>\n' "$0" >&2
  exit 64
}

tool_jar=''
cassandra_home=''
java_home=''
output_root=''

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tool-jar) tool_jar=${2:-}; shift 2 ;;
    --cassandra-home) cassandra_home=${2:-}; shift 2 ;;
    --java-home) java_home=${2:-}; shift 2 ;;
    --output-root) output_root=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n "$tool_jar" && -n "$cassandra_home" && -n "$java_home" && -n "$output_root" ]] || usage
[[ -f "$tool_jar" && -d "$cassandra_home" && -x "$java_home/bin/java" ]] || {
  printf 'Invalid tool, Cassandra home, or Java home\n' >&2
  exit 1
}

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fixture_dir="$root_dir/legacy-reader-3.11/src/test/resources"
source_dir="$output_root/legacy-ma-source"
schema="$output_root/legacy-ma-schema.cql"
tmp_parent="$output_root/direct-tmp"
mkdir -p "$source_dir"
cp "$fixture_dir"/ma-2-big-* "$source_dir/"

printf '%s\n' \
  "CREATE KEYSPACE fixture WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};" \
  'CREATE TABLE fixture.users (user_name varchar PRIMARY KEY, password varchar, gender varchar, state varchar, birth_year bigint);' \
  >"$schema"

(
  cd "$source_dir"
  sha256sum ma-2-big-* | sort >"$output_root/legacy-ma-source.sha256"
)

source_list() {
  local files=()
  mapfile -t files < <(find "$source_dir" -maxdepth 1 -type f -name '*-Data.db' -print | sort)
  (IFS=,; printf '%s' "${files[*]}")
}

run_cql() {
  local name=$1
  local statement=$2
  java -jar "$tool_jar" --tmp-dir "$tmp_parent" --cassandra-home "$cassandra_home" \
    --java-home "$java_home" --sstables "$(source_list)" --schema "$schema" cqlsh \
    --execute "$statement" | tee "$output_root/legacy-ma-$name.log"
}

initial_tocs=$(find "$source_dir" -maxdepth 1 -type f -name '*-TOC.txt' | wc -l)
run_cql select-base "SELECT user_name, password, gender, state, birth_year FROM fixture.users WHERE user_name = 'frodo';"
grep -q 'frodo' "$output_root/legacy-ma-select-base.log"
grep -q 'pass@' "$output_root/legacy-ma-select-base.log"
grep -q 'published.sstables=none' "$output_root/legacy-ma-select-base.log"

run_cql insert "INSERT INTO fixture.users (user_name, password, gender, state, birth_year) VALUES ('samwise', 'gardener', 'male', 'shire', 1380) USING TIMESTAMP 2000000000000000;"
[[ $(find "$source_dir" -maxdepth 1 -type f -name '*-TOC.txt' | wc -l) -gt $initial_tocs ]] || {
  printf 'Legacy ma INSERT did not publish a delta SSTable\n' >&2
  exit 1
}

run_cql update "UPDATE fixture.users USING TIMESTAMP 2000000000000001 SET password = 'mayor' WHERE user_name = 'samwise';"
find "$source_dir" -maxdepth 1 -type f -name 'nb-*-big-Data.db' -print -quit | grep -q . || {
  printf 'Legacy ma mutation did not publish Cassandra 4.x nb SSTables\n' >&2
  exit 1
}

run_cql select-mutated "SELECT user_name, password, gender, state, birth_year FROM fixture.users WHERE user_name = 'samwise';"
grep -q 'samwise' "$output_root/legacy-ma-select-mutated.log"
grep -q 'mayor' "$output_root/legacy-ma-select-mutated.log"
grep -q 'shire' "$output_root/legacy-ma-select-mutated.log"
grep -q 'published.sstables=none' "$output_root/legacy-ma-select-mutated.log"

(
  cd "$source_dir"
  sha256sum --check "$output_root/legacy-ma-source.sha256"
)
[[ ! -d "$tmp_parent" || -z "$(find "$tmp_parent" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -print -quit)" ]] || {
  printf 'Legacy ma direct cqlsh left a successful private workspace behind\n' >&2
  exit 1
}

printf 'Verified legacy Cassandra 3.11 ma fixture through direct cqlsh mutation and nb publication.\n'
