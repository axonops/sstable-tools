#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s --image <image> --release <line> --tool-jar <path> --output-root <path> [--expect-format <version> --import-cassandra-home <path> --java-home <path>]\n' "$0" >&2
  exit 64
}

image=''
release=''
tool_jar=''
output_root=''
import_cassandra_home=''
java_home=''
expected_format=''

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image) image=${2:-}; shift 2 ;;
    --release) release=${2:-}; shift 2 ;;
    --tool-jar) tool_jar=${2:-}; shift 2 ;;
    --output-root) output_root=${2:-}; shift 2 ;;
    --import-cassandra-home) import_cassandra_home=${2:-}; shift 2 ;;
    --java-home) java_home=${2:-}; shift 2 ;;
    --expect-format) expected_format=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n "$image" && -n "$release" && -n "$tool_jar" && -n "$output_root" ]] || usage
[[ -f "$tool_jar" ]] || { printf 'Tool JAR not found: %s\n' "$tool_jar" >&2; exit 1; }
if [[ -n "$import_cassandra_home" || -n "$java_home" ]]; then
  [[ -n "$import_cassandra_home" && -n "$java_home" ]] || usage
  [[ -d "$import_cassandra_home/lib" ]] || {
    printf 'Cassandra home does not contain lib/: %s\n' "$import_cassandra_home" >&2
    exit 1
  }
  [[ -x "$java_home/bin/java" ]] || { printf 'Invalid Java home: %s\n' "$java_home" >&2; exit 1; }
fi

container="sstable-tools-ci-${release//./-}-${GITHUB_RUN_ID:-local}-${GITHUB_RUN_ATTEMPT:-0}"
container=${container:0:63}
source_dir="$output_root/source"
workspace="$output_root/workspace"
schema="$output_root/schema.cql"
provenance="$output_root/fixture-provenance.json"
mkdir -p "$source_dir"

cleanup() {
  docker rm -f "$container" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker pull "$image"
docker run -d --name "$container" \
  -e MAX_HEAP_SIZE=512M \
  -e HEAP_NEWSIZE=128M \
  "$image" >/dev/null

ready=false
for attempt in $(seq 1 90); do
  if docker exec "$container" cqlsh 127.0.0.1 9042 -e \
      'SELECT release_version FROM system.local;' >"$output_root/cqlsh-ready.log" 2>&1; then
    ready=true
    break
  fi
  sleep 2
done
if [[ "$ready" != true ]]; then
  docker logs "$container" >"$output_root/cassandra.log" 2>&1 || true
  printf 'Cassandra %s did not become ready\n' "$release" >&2
  exit 1
fi

run_cqlsh() {
  local statement=$1
  printf 'cqlsh> %s\n' "$statement"
  docker exec "$container" cqlsh 127.0.0.1 9042 -e "$statement"
}

run_cqlsh "CREATE KEYSPACE ci_source WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};"
run_cqlsh 'CREATE TABLE ci_source.events (event_id text PRIMARY KEY, payload text, state text);'
run_cqlsh "INSERT INTO ci_source.events (event_id, payload, state) VALUES ('source-row', 'seed', 'new');"
run_cqlsh "UPDATE ci_source.events SET payload = 'updated', state = 'ready' WHERE event_id = 'source-row';"
selected="$(docker exec "$container" cqlsh 127.0.0.1 9042 -e \
  "SELECT event_id, payload, state FROM ci_source.events WHERE event_id = 'source-row';")"
printf '%s\n' "$selected"
[[ "$selected" == *source-row* && "$selected" == *updated* && "$selected" == *ready* ]] || {
  printf 'Stock cqlsh did not return the expected mutated row\n' >&2
  exit 1
}

producer_info="$(docker exec "$container" cqlsh 127.0.0.1 9042 -e \
  'SELECT release_version, partitioner FROM system.local;')"
printf '%s\n' "$producer_info" | tee "$output_root/producer-info.log"
producer_version="$(printf '%s\n' "$producer_info" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)"
partitioner="$(printf '%s\n' "$producer_info" | grep -Eo 'org\.apache\.cassandra\.dht\.[A-Za-z0-9_.]+' | head -n 1)"
[[ -n "$producer_version" && "$producer_version" == "$release".* ]] || {
  printf 'Could not verify Cassandra %s producer version\n' "$release" >&2
  exit 1
}
[[ -n "$partitioner" ]] || { printf 'Could not record producer partitioner\n' >&2; exit 1; }

docker exec "$container" nodetool flush ci_source events
table_dir="$(docker exec "$container" sh -c \
  "find /var/lib/cassandra/data/ci_source -mindepth 1 -maxdepth 1 -type d -name 'events-*' | head -n 1")"
[[ -n "$table_dir" ]] || { printf 'No flushed table directory found\n' >&2; exit 1; }
docker stop "$container" >/dev/null
[[ "$(docker inspect -f '{{.State.Running}}' "$container")" == false ]] || {
  printf 'Cassandra source container is still running\n' >&2
  exit 1
}
docker cp "$container:$table_dir/." "$source_dir"
find "$source_dir" -maxdepth 1 -type f -printf '%f\n' | sort | tee "$output_root/source-components.txt"
(
  cd "$source_dir"
  find . -maxdepth 1 -type f -exec sha256sum {} + | sort >"$output_root/source-components.sha256"
)
selected_sstable="$(find "$source_dir" -maxdepth 1 -name '*-Data.db' -print -quit)"
[[ -n "$selected_sstable" ]] || {
  printf 'Stopped Cassandra source did not yield Data.db\n' >&2
  exit 1
}
if [[ -n "$expected_format" ]]; then
  selected_name=$(basename "$selected_sstable")
  [[ "$selected_name" == "$expected_format"-*-big-Data.db ]] || {
    printf 'Expected %s SSTable format, found %s\n' "$expected_format" "$selected_name" >&2
    exit 1
  }
fi
selected_name=$(basename "$selected_sstable")
if [[ "$selected_name" =~ ^([a-z][a-z])-[0-9]+-(big|bti)-Data\.db$ ]]; then
  format_version=${BASH_REMATCH[1]}
  format=${BASH_REMATCH[2]}
else
  printf 'Could not parse SSTable format from %s\n' "$selected_name" >&2
  exit 1
fi

printf '%s\n' \
  "CREATE KEYSPACE ci_source WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};" \
  'CREATE TABLE ci_source.events (event_id text PRIMARY KEY, payload text, state text);' \
  >"$schema"

node - "$provenance" "$release" "$producer_version" "$image" "$partitioner" "$format_version" "$format" "$source_dir" <<'NODE'
const crypto = require('crypto');
const fs = require('fs');
const [output, releaseLine, producerVersion, image, partitioner, formatVersion, format, sourceDir] = process.argv.slice(2);
const schema = fs.readFileSync(`${require('path').dirname(output)}/schema.cql`, 'utf8');
const components = fs.readdirSync(sourceDir, { withFileTypes: true })
  .filter((entry) => entry.isFile())
  .map((entry) => entry.name)
  .sort()
  .map((name) => ({
  name,
  sha256: crypto.createHash('sha256').update(fs.readFileSync(`${sourceDir}/${name}`)).digest('hex'),
}));
const manifest = {
  formatVersion: 1,
  producer: {
    releaseLine,
    version: producerVersion,
    image,
    partitioner,
  },
  sstable: {
    format,
    formatVersion,
    compression: 'default Cassandra table compression',
    components,
  },
  schema,
  sourceMutationScript: [
    "INSERT INTO ci_source.events (event_id, payload, state) VALUES ('source-row', 'seed', 'new');",
    "UPDATE ci_source.events SET payload = 'updated', state = 'ready' WHERE event_id = 'source-row';",
  ],
  expectedLogicalRows: [{ event_id: 'source-row', payload: 'updated', state: 'ready' }],
};
fs.writeFileSync(output, `${JSON.stringify(manifest, null, 2)}\n`);
NODE

java -jar "$tool_jar" workspace create "$workspace" --sstables "$selected_sstable" --schema "$schema" \
  | tee "$output_root/workspace-create.log"
java -jar "$tool_jar" workspace status "$workspace" \
  | tee "$output_root/workspace-status.log"
grep -q 'workspace.state=VALIDATED' "$output_root/workspace-create.log"
grep -q 'source.integrity=verified' "$output_root/workspace-status.log"

if [[ -n "$import_cassandra_home" ]]; then
  java -jar "$tool_jar" --cassandra-home "$import_cassandra_home" --java-home "$java_home" \
    workspace import "$workspace" | tee "$output_root/workspace-import.log"
  java -jar "$tool_jar" workspace status "$workspace" \
    | tee "$output_root/workspace-import-status.log"
  grep -q 'workspace.state=IMPORTED' "$output_root/workspace-import.log"
  grep -q 'source.integrity=verified' "$output_root/workspace-import-status.log"
fi

(
  cd "$source_dir"
  sha256sum --check "$output_root/source-components.sha256"
)

printf 'Verified Cassandra %s stock-cqlsh source generation and stopped-SSTable workspace capture.\n' \
  "$release"
