#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s --image <image> --tool-jar <path> --cassandra-home <path> --java-home <path> --output-root <path> [--storage-compatibility-mode CASSANDRA_4|UPGRADING|NONE --sstable-format big|bti] [--repeat-imports <count>]\n' "$0" >&2
  exit 64
}

image=''
tool_jar=''
cassandra_home=''
java_home=''
output_root=''
storage_compatibility_mode=''
sstable_format=''
repeat_imports=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image) image=${2:-}; shift 2 ;;
    --tool-jar) tool_jar=${2:-}; shift 2 ;;
    --cassandra-home) cassandra_home=${2:-}; shift 2 ;;
    --java-home) java_home=${2:-}; shift 2 ;;
    --output-root) output_root=${2:-}; shift 2 ;;
    --storage-compatibility-mode) storage_compatibility_mode=${2:-}; shift 2 ;;
    --sstable-format) sstable_format=${2:-}; shift 2 ;;
    --repeat-imports) repeat_imports=${2:-}; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n "$image" && -n "$tool_jar" && -n "$cassandra_home" \
  && -n "$java_home" && -n "$output_root" ]] || usage
[[ -f "$tool_jar" ]] || { printf 'Tool JAR not found: %s\n' "$tool_jar" >&2; exit 1; }
[[ -d "$cassandra_home/lib" ]] || {
  printf 'Cassandra home does not contain lib/: %s\n' "$cassandra_home" >&2
  exit 1
}
[[ -x "$java_home/bin/java" ]] || { printf 'Invalid Java home: %s\n' "$java_home" >&2; exit 1; }
case "$storage_compatibility_mode" in
  ''|CASSANDRA_4|UPGRADING|NONE) ;;
  *) printf 'Unsupported storage compatibility mode: %s\n' \
       "$storage_compatibility_mode" >&2; exit 64 ;;
esac
case "$sstable_format" in
  ''|big|bti) ;;
  *) printf 'Unsupported SSTable format: %s\n' "$sstable_format" >&2; exit 64 ;;
esac
if [[ -n "$storage_compatibility_mode" || -n "$sstable_format" ]]; then
  [[ -n "$storage_compatibility_mode" && -n "$sstable_format" ]] || usage
fi
if [[ "$storage_compatibility_mode" == CASSANDRA_4 && "$sstable_format" == bti ]]; then
  printf 'CASSANDRA_4 mode cannot use BTI\n' >&2
  exit 64
fi
[[ "$repeat_imports" =~ ^[0-9]+$ && "$repeat_imports" -le 10 ]] || {
  printf 'Repeat import count must be between 0 and 10\n' >&2
  exit 64
}

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

container="sstable-tools-system-local-${GITHUB_RUN_ID:-local}-${GITHUB_RUN_ATTEMPT:-0}"
container=${container:0:63}
captured_source="$output_root/source-captured"
source_dir="$output_root/source-data"
secondary_source_dir="$output_root/source-log-data"
schema="$output_root/system.local.cql"
mkdir -p "$captured_source" "$source_dir" "$secondary_source_dir"

cleanup() {
  docker rm -f "$container" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker pull "$image"
docker create --name "$container" \
  -e MAX_HEAP_SIZE=512M \
  -e HEAP_NEWSIZE=128M \
  "$image" >/dev/null
if [[ -n "$storage_compatibility_mode" ]]; then
  original_start_yaml="$output_root/source-cassandra.yaml"
  configured_start_yaml="$output_root/source-cassandra-configured.yaml"
  docker cp "$container:/etc/cassandra/cassandra.yaml" "$original_start_yaml"
  "$script_dir/ci-configure-cassandra50-yaml" "$original_start_yaml" \
    "$configured_start_yaml" "$storage_compatibility_mode" "$sstable_format"
  docker cp "$configured_start_yaml" "$container:/etc/cassandra/cassandra.yaml"

  runtime_yaml="$cassandra_home/conf/cassandra.yaml"
  [[ -f "$runtime_yaml" ]] || {
    printf 'Cassandra runtime configuration is missing: %s\n' "$runtime_yaml" >&2
    exit 1
  }
  configured_runtime_yaml="$output_root/runtime-cassandra-configured.yaml"
  "$script_dir/ci-configure-cassandra50-yaml" "$runtime_yaml" \
    "$configured_runtime_yaml" "$storage_compatibility_mode" "$sstable_format"
  cp "$configured_runtime_yaml" "$runtime_yaml"
fi
docker start "$container" >/dev/null

ready=false
for _ in $(seq 1 90); do
  if docker exec "$container" cqlsh 127.0.0.1 9042 -e \
      'SELECT cluster_name, release_version FROM system.local;' \
      >"$output_root/source-row.log" 2>&1; then
    ready=true
    break
  fi
  sleep 2
done
if [[ "$ready" != true ]]; then
  docker logs "$container" >"$output_root/cassandra.log" 2>&1 || true
  printf 'Cassandra system.local source did not become ready\n' >&2
  exit 1
fi

source_row=$(<"$output_root/source-row.log")
printf '%s\n' "$source_row"
cluster_name=$(printf '%s\n' "$source_row" | awk -F '|' '
  /^[[:space:]]*[^-+[:space:]][^|]*\|/ {
    value=$1
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
    if (value != "cluster_name") {
      print value
      exit
    }
  }')
release_version=$(printf '%s\n' "$source_row" \
  | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)
[[ -n "$cluster_name" && -n "$release_version" ]] || {
  printf 'Could not parse the source system.local identity\n' >&2
  exit 1
}

{
  printf "CREATE KEYSPACE system WITH replication = {'class': 'LocalStrategy'};\n\n"
  docker exec "$container" cqlsh 127.0.0.1 9042 -e 'DESCRIBE TABLE system.local'
} >"$schema"

docker exec "$container" nodetool flush system local
table_dir=$(docker exec "$container" sh -c \
  "find /var/lib/cassandra/data/system -mindepth 1 -maxdepth 1 -type d -name 'local-*' | head -n 1")
[[ -n "$table_dir" ]] || { printf 'No flushed system.local directory found\n' >&2; exit 1; }

docker stop "$container" >/dev/null
[[ "$(docker inspect -f '{{.State.Running}}' "$container")" == false ]] || {
  printf 'Cassandra system.local source container is still running\n' >&2
  exit 1
}
docker cp "$container:$table_dir/." "$captured_source"

find "$captured_source" -maxdepth 1 -type f -exec cp -t "$source_dir" -- {} +

find "$source_dir" -maxdepth 1 -type f -printf '%p\n' \
  | sort | tee "$output_root/source-components.txt"
(
  cd "$output_root"
  find source-data -maxdepth 1 -type f -exec sha256sum {} + \
    | sort >"$output_root/source-components.sha256"
)
find "$source_dir" -maxdepth 1 -type f -name '*-Data.db' -print -quit \
  | grep -q . || { printf 'Stopped system.local source did not yield Data.db\n' >&2; exit 1; }
expected_version=''
expected_format=''
case "$storage_compatibility_mode" in
  CASSANDRA_4) expected_version=nb ;;
  UPGRADING|NONE)
    if [[ "$sstable_format" == bti ]]; then
      expected_version=da
    else
      expected_version=oa
    fi
    ;;
esac
if [[ -n "$expected_version" ]]; then
  expected_format=$sstable_format
  find "$source_dir" -maxdepth 1 -type f \
    -name "$expected_version-*-$expected_format-Data.db" \
    -print -quit | grep -q . || {
      printf 'Cassandra %s/%s did not produce expected %s/%s source SSTables\n' \
        "$storage_compatibility_mode" "$sstable_format" \
        "$expected_version" "$expected_format" >&2
      exit 1
    }
fi

if [[ "$sstable_format" == bti ]]; then
  expect_missing_bti_component() {
    local component=$1
    local rejection="$output_root/missing-${component%.db}"
    mkdir -p "$rejection"
    cp "$source_dir"/* "$rejection/"
    rm "$rejection/$expected_version-"*"-bti-$component"
    sed -i "/^${component//./\.}$/d" \
      "$rejection/$expected_version-"*'-bti-TOC.txt'

    set +e
    java -jar "$tool_jar" --cassandra-home "$cassandra_home" \
      --java-home "$java_home" --sstables "$rejection" --schema "$schema" cqlsh \
      --execute 'SELECT cluster_name FROM system.local;' \
      >"$output_root/missing-${component%.db}.log" 2>&1
    local exit_code=$?
    set -e
    [[ $exit_code -ne 0 ]] || {
      printf 'BTI SSTable missing %s was accepted\n' "$component" >&2
      exit 1
    }
    grep -Fq "missing required component $component" \
      "$output_root/missing-${component%.db}.log"
  }

  expect_missing_bti_component Partitions.db
  expect_missing_bti_component Rows.db
fi

first_data_center='sstable-tools-dc'
java -jar "$tool_jar" --cassandra-home "$cassandra_home" --java-home "$java_home" \
  --sstables "$source_dir" --output-dir "$secondary_source_dir" \
  --schema "$schema" cqlsh \
  --execute "UPDATE system.local USING TIMESTAMP 2000000000000000 SET data_center = '$first_data_center' WHERE key = 'local'; SELECT cluster_name, data_center FROM system.local;" \
  | tee "$output_root/first-directory-update.log"

grep -Fq "$cluster_name" "$output_root/first-directory-update.log"
grep -Fq "$first_data_center" "$output_root/first-directory-update.log"
first_published=$(sed -n 's/^published\.sstables=//p' \
  "$output_root/first-directory-update.log" | tail -n 1)
[[ -n "$first_published" && "$first_published" != none ]] || {
  printf 'The first cross-directory update did not publish an SSTable\n' >&2
  exit 1
}
[[ -f "$secondary_source_dir/$first_published-TOC.txt" ]] || {
  printf 'Published SSTable is missing from the second data directory: %s\n' \
    "$first_published" >&2
  exit 1
}
if [[ -n "$expected_version" \
      && "$first_published" != "$expected_version"-*-$expected_format ]]; then
  printf 'First published descriptor %s does not follow %s/%s (expected %s/%s)\n' \
    "$first_published" "$storage_compatibility_mode" "$sstable_format" \
    "$expected_version" "$expected_format" >&2
  exit 1
fi
find "$secondary_source_dir" -maxdepth 1 -type f -name '*-Data.db' -print -quit \
  | grep -q . || { printf 'First update did not create a second-directory Data.db\n' >&2; exit 1; }
(
  cd "$output_root"
  sha256sum --check "$output_root/source-components.sha256"
)

partial_data="$secondary_source_dir/$first_published-Data.db"
partial_descriptor=$first_published
partial_directory=$secondary_source_dir
set +e
java -jar "$tool_jar" --cassandra-home "$cassandra_home" --java-home "$java_home" \
  --sstables "$partial_data" --schema "$schema" cqlsh \
  --execute 'SELECT cluster_name FROM system.local;' \
  >"$output_root/partial-selection.log" 2>&1
partial_exit=$?
set -e
[[ "$partial_exit" -ne 0 ]] || {
  printf 'Partial system.local selection unexpectedly succeeded\n' >&2
  exit 1
}
grep -Fq 'selection is partial' "$output_root/partial-selection.log"
grep -Fq 'Select every SSTable for system.local' "$output_root/partial-selection.log"
grep -Fq "$partial_descriptor in $partial_directory" \
  "$output_root/partial-selection.log"

java -jar "$tool_jar" --cassandra-home "$cassandra_home" --java-home "$java_home" \
  --sstables "$source_dir" --sstables "$secondary_source_dir" \
  --output-dir "$source_dir" --schema "$schema" cqlsh \
  --execute 'SELECT cluster_name, release_version, data_center FROM system.local;' \
  | tee "$output_root/direct-select.log"

grep -Fq "$cluster_name" "$output_root/direct-select.log"
grep -Fq "$release_version" "$output_root/direct-select.log"
grep -Fq "$first_data_center" "$output_root/direct-select.log"
grep -q 'published.sstables=none' "$output_root/direct-select.log"
(
  cd "$output_root"
  sha256sum --check "$output_root/source-components.sha256"
)

for attempt in $(seq 1 "$repeat_imports"); do
  java -jar "$tool_jar" --cassandra-home "$cassandra_home" --java-home "$java_home" \
    --sstables "$source_dir" --sstables "$secondary_source_dir" \
    --output-dir "$source_dir" --schema "$schema" cqlsh \
    --execute 'SELECT cluster_name, release_version, data_center FROM system.local;' \
    >"$output_root/repeated-import-$attempt.log"
  grep -Fq "$cluster_name" "$output_root/repeated-import-$attempt.log"
  grep -Fq "$first_data_center" "$output_root/repeated-import-$attempt.log"
  grep -q 'published.sstables=none' "$output_root/repeated-import-$attempt.log"
done

find "$source_dir" "$secondary_source_dir" -maxdepth 1 -type f \
  -name '*-TOC.txt' -printf '%f\n' \
  | sed 's/-TOC\.txt$//' | sort -u >"$output_root/occupied-before-second-update.txt"
second_rack='sstable-tools-rack'

java -jar "$tool_jar" --cassandra-home "$cassandra_home" --java-home "$java_home" \
  --sstables "$source_dir" --sstables "$secondary_source_dir" \
  --output-dir "$source_dir" --schema "$schema" cqlsh \
  --execute "UPDATE system.local USING TIMESTAMP 2000000000000001 SET rack = '$second_rack' WHERE key = 'local'; SELECT cluster_name, data_center, rack FROM system.local;" \
  | tee "$output_root/direct-update.log"

grep -Fq "$cluster_name" "$output_root/direct-update.log"
grep -Fq "$first_data_center" "$output_root/direct-update.log"
grep -Fq "$second_rack" "$output_root/direct-update.log"
second_published=$(sed -n 's/^published\.sstables=//p' \
  "$output_root/direct-update.log" | tail -n 1)
[[ -n "$second_published" && "$second_published" != none ]] || {
  printf 'The combined cross-directory update did not publish an SSTable\n' >&2
  exit 1
}
[[ -f "$source_dir/$second_published-TOC.txt" ]] || {
  printf 'Published SSTable is missing from the named output directory: %s\n' \
    "$second_published" >&2
  exit 1
}
if [[ -n "$expected_version" \
      && "$second_published" != "$expected_version"-*-$expected_format ]]; then
  printf 'Second published descriptor %s does not follow %s/%s (expected %s/%s)\n' \
    "$second_published" "$storage_compatibility_mode" "$sstable_format" \
    "$expected_version" "$expected_format" >&2
  exit 1
fi
if grep -Fxq "$second_published" "$output_root/occupied-before-second-update.txt"; then
  printf 'Cross-directory identifier allocation reused %s\n' "$second_published" >&2
  exit 1
fi
duplicate_descriptors=$(find "$source_dir" "$secondary_source_dir" -maxdepth 1 \
  -type f -name '*-TOC.txt' -printf '%f\n' \
  | sed 's/-TOC\.txt$//' | sort | uniq -d)
[[ -z "$duplicate_descriptors" ]] || {
  printf 'Duplicate SSTable descriptors exist across data directories:\n%s\n' \
    "$duplicate_descriptors" >&2
  exit 1
}
(
  cd "$output_root"
  sha256sum --check "$output_root/source-components.sha256"
)

java -jar "$tool_jar" --cassandra-home "$cassandra_home" --java-home "$java_home" \
  --sstables "$source_dir" --sstables "$secondary_source_dir" \
  --output-dir "$source_dir" --schema "$schema" cqlsh \
  --execute 'SELECT cluster_name, release_version, data_center, rack FROM system.local;' \
  | tee "$output_root/final-read-back.log"

grep -Fq "$cluster_name" "$output_root/final-read-back.log"
grep -Fq "$release_version" "$output_root/final-read-back.log"
grep -Fq "$first_data_center" "$output_root/final-read-back.log"
grep -Fq "$second_rack" "$output_root/final-read-back.log"
grep -q 'published.sstables=none' "$output_root/final-read-back.log"

table_name=${table_dir##*/}
actual_secondary_root="$output_root/actual-log-data"
actual_secondary_table="$actual_secondary_root/system/$table_name"
mkdir -p "$actual_secondary_table"
cp "$secondary_source_dir"/* "$actual_secondary_table/"

docker cp "$source_dir/." "$container:$table_dir"
docker cp "$actual_secondary_root" "$container:/var/lib/cassandra/log-data"

restart_yaml="$output_root/restart-cassandra.yaml"
docker cp "$container:/etc/cassandra/cassandra.yaml" \
  "$output_root/original-cassandra.yaml"
awk '
  BEGIN { replacing_data = 0; saw_data = 0; saw_snitch = 0 }
  /^data_file_directories:[[:space:]]*$/ {
    print "data_file_directories:"
    print "    - /var/lib/cassandra/data"
    print "    - /var/lib/cassandra/log-data"
    replacing_data = 1
    saw_data = 1
    next
  }
  replacing_data && /^[[:space:]]*-[[:space:]]/ { next }
  replacing_data { replacing_data = 0 }
  /^endpoint_snitch:[[:space:]]*/ {
    print "endpoint_snitch: GossipingPropertyFileSnitch"
    saw_snitch = 1
    next
  }
  { print }
  END {
    if (!saw_data) {
      print ""
      print "data_file_directories:"
      print "    - /var/lib/cassandra/data"
      print "    - /var/lib/cassandra/log-data"
    }
    if (!saw_snitch) {
      exit 42
    }
  }
' "$output_root/original-cassandra.yaml" >"$restart_yaml"
docker cp "$restart_yaml" "$container:/etc/cassandra/cassandra.yaml"

restart_rackdc="$output_root/restart-cassandra-rackdc.properties"
docker cp "$container:/etc/cassandra/cassandra-rackdc.properties" \
  "$output_root/original-cassandra-rackdc.properties"
awk -v dc="$first_data_center" -v rack="$second_rack" '
  /^dc=/ { print "dc=" dc; saw_dc = 1; next }
  /^rack=/ { print "rack=" rack; saw_rack = 1; next }
  { print }
  END {
    if (!saw_dc) print "dc=" dc
    if (!saw_rack) print "rack=" rack
  }
' "$output_root/original-cassandra-rackdc.properties" >"$restart_rackdc"
docker cp "$restart_rackdc" \
  "$container:/etc/cassandra/cassandra-rackdc.properties"

docker start "$container" >/dev/null
restored_ready=false
for _ in $(seq 1 90); do
  if docker exec "$container" cqlsh 127.0.0.1 9042 -e \
      'SELECT cluster_name, release_version, data_center, rack FROM system.local;' \
      >"$output_root/real-cassandra-read-back.log" 2>&1; then
    restored_ready=true
    break
  fi
  sleep 2
done
if [[ "$restored_ready" != true ]]; then
  docker logs "$container" >"$output_root/restarted-cassandra.log" 2>&1 || true
  printf 'Real Cassandra could not restart from the two data directories\n' >&2
  exit 1
fi

real_read_back=$(<"$output_root/real-cassandra-read-back.log")
printf '%s\n' "$real_read_back"
grep -Fq "$cluster_name" "$output_root/real-cassandra-read-back.log"
grep -Fq "$release_version" "$output_root/real-cassandra-read-back.log"
grep -Fq "$first_data_center" "$output_root/real-cassandra-read-back.log"
grep -Fq "$second_rack" "$output_root/real-cassandra-read-back.log"

docker stop "$container" >/dev/null
[[ "$(docker inspect -f '{{.State.Running}}' "$container")" == false ]] || {
  printf 'Restored real Cassandra container is still running\n' >&2
  exit 1
}

printf 'Verified sstable-tools updates in two real Cassandra data directories for Cassandra %s.\n' \
  "$release_version"
