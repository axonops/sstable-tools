#!/usr/bin/env bash
set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temporary="$(mktemp -d)"
cleanup() {
  rm -rf -- "$temporary"
}
trap cleanup EXIT

fake_bin="$temporary/bin"
release_dir="$temporary/release/sstable-tools-1.2.3"
mkdir -p "$fake_bin" "$release_dir"
printf 'deb\n' >"$release_dir/sstable-tools_1.2.3-1_all.deb"
printf 'rpm\n' >"$release_dir/sstable-tools-1.2.3-1.noarch.rpm"

cat >"$fake_bin/gcloud" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

for argument in "$@"; do
  printf '%q ' "$argument" >>"$MOCK_GCLOUD_LOG"
done
printf '\n' >>"$MOCK_GCLOUD_LOG"

case "${1:-} ${2:-} ${3:-}" in
  "artifacts apt upload"|"artifacts yum upload")
    ;;
  *)
    exit 2
    ;;
esac
EOF
chmod 0755 "$fake_bin/gcloud"

publish_log="$temporary/publish.log"
MOCK_GCLOUD_LOG="$publish_log" \
  PATH="$fake_bin:$PATH" \
  "$root_dir/scripts/publish-google-artifacts" \
    --release-dir "$release_dir"

grep -Fq 'artifacts apt upload axonops-apt' "$publish_log"
grep -Fq 'artifacts yum upload axonops-yum' "$publish_log"
grep -Fq -- '--project=axonops-public' "$publish_log"
grep -Fq -- '--location=europe' "$publish_log"
grep -Fq "$release_dir/sstable-tools_1.2.3-1_all.deb" "$publish_log"
grep -Fq "$release_dir/sstable-tools-1.2.3-1.noarch.rpm" "$publish_log"

if grep -Fq 'artifacts repositories' "$publish_log"; then
  printf 'Publisher unexpectedly queried Artifact Registry repositories\n' >&2
  exit 1
fi

printf 'Google Artifact Registry publication tests passed\n'
